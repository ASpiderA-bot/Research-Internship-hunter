# LLM provider: 'gemini' or 'groq'. Groq has higher free-tier rate limits.
LLM_PROVIDER=groq

# GROQ_API_KEY: Required when LLM_PROVIDER=groq. Get one at https://console.groq.com/
GROQ_API_KEY="YOUR_GROQ_API_KEY"
# GROQ_MODEL: Default model for Groq. Llama 3.3 70B is a good balance of quality and free-tier limits.
GROQ_MODEL="llama-3.3-70b-versatile"

# GEMINI_API_KEY: Required when LLM_PROVIDER=gemini, and required for PDF parsing when using Groq.
# Get one at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# Optional tuning
# PORT=3000
# SEARCH_TIMEOUT_MS=5000
# SCRAPE_TIMEOUT_MS=4000
# MAX_SEARCH_URLS=8
# MAX_RESULTS=24
