# LLM provider: 'gemini' or 'groq'. Groq has higher free-tier rate limits.
LLM_PROVIDER=groq

# GROQ_API_KEY: Required when LLM_PROVIDER=groq. Get one at https://console.groq.com/
GROQ_API_KEY="YOUR_GROQ_API_KEY"
# GROQ_MODEL: Default model for Groq. openai/gpt-oss-120b supports structured outputs and has a generous free tier.
GROQ_MODEL="openai/gpt-oss-120b"

# GEMINI_API_KEY: Required when LLM_PROVIDER=gemini, and required for PDF parsing when using Groq.
# Get one at https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# Optional tuning
# PORT=3000
# SEARCH_TIMEOUT_MS=5000
# SCRAPE_TIMEOUT_MS=4000
# MAX_SEARCH_URLS=8
# MAX_RESULTS=24
